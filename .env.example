# Copy to .env and fill in the REQUIRED section. Never commit .env.
# The optional lines below are the ones you are likely to change; the commented
# value is the built-in default. Every other setting (pricing tuning, model
# names, schedules, offer rules) has its default and explanation in config.py
# and can be overridden here under the same name.

# =============================================================================
# REQUIRED (the bot cannot list, price or publish without these)
# =============================================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to drive the bot. Send /whoami to the
# bot to get yours. UNSET MEANS THE BOT IS OPEN TO ANYONE.
TELEGRAM_ALLOWED_USER_IDS=

# --- eBay developer app (then run: python -m ebay.auth) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The eBay "RuName", not a real URL
EBAY_REDIRECT_URI=

# --- AI providers ---
GEMINI_API_KEY=
# Read by the Anthropic SDK itself (claude_llm.py)
ANTHROPIC_API_KEY=

# --- Comps scraping (Apify) ---
APIFY_TOKEN=
# Second account, used when APIFY_TOKEN is rejected or out of credit
APIFY_TOKEN_BACKUP=

# --- Photo hosting (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# OPTIONAL
# =============================================================================

# Full path to tesseract.exe if it is not on PATH (Windows)
# TESSERACT_CMD=

# --- eBay ---
# Pin specific Business Policies (otherwise the first one on the account is used)
# EBAY_FULFILLMENT_POLICY_ID=
# EBAY_RETURN_POLICY_ID=
# Promoted Listings ad rate (%) applied on publish
# EBAY_DEFAULT_AD_RATE_PCT=4
# Auto-decline Best Offers below this % of list price
# BEST_OFFER_MIN_PCT=75

# --- Money assumptions (used for profit floors) ---
# Shipping charged to buyer / label cost. If you ship free, set EBAY_SHIP_CHARGED=0
# EBAY_SHIP_CHARGED=9.88
# EBAY_SHIP_COST=7.20
# Assumed cost as a share of list price when no receipt was captured
# ASSUMED_COST_RATIO=0.29
# Largest single automatic price cut, as a fraction
# REPRICE_MAX_CUT_PCT=0.12
# Monthly Anthropic budget in USD (warns, then downgrades models near the limit)
# ANTHROPIC_MONTHLY_BUDGET=100

# --- Switches ---
# Local testing only: fewer comps, faster and cheaper, WRONG prices
# DEBUG_MODE=false
# Let confident items skip the identify/price confirm (review before eBay never skipped)
# AUTO_CONFIRM=true
# Check stock photos match the item before listing
# LISTING_CHECK_ENABLED=true
# Scheduled jobs. Set to 0 to turn off.
# SYNC_ENABLED=1
# SOLD_ALERTS_ENABLED=1
# FEEDBACK_ENABLED=1
