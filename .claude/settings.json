{
  "permissions": {
    "allow": [
      "Bash(python -m pytest*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "PowerShell(python -m pytest*)",
      "PowerShell(git status*)",
      "PowerShell(git log*)",
      "PowerShell(git diff*)",
      "PowerShell(git show*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "python",
            "args": ["scripts/precommit_tests.py"],
            "timeout": 600,
            "onFailure": "block",
            "statusMessage": "Running tests before commit..."
          },
          {
            "type": "command",
            "if": "PowerShell(git commit*)",
            "command": "python",
            "args": ["scripts/precommit_tests.py"],
            "timeout": 600,
            "onFailure": "block",
            "statusMessage": "Running tests before commit..."
          }
        ]
      }
    ]
  }
}
